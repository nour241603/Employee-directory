{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnTablesDepartmentsAndRoles",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/Departments",
        "arn:aws:dynamodb:us-east-1:000000000000:table/Roles"
      ]
    },
    {
      "Sid": "ReadEmployeesAndSetTheirRole",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Scan", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/Employees"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/empdir-organization-api:*"
    }
  ]
}
