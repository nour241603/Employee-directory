{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmployeesTableReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:*:table/Employees"
    },
    {
      "Sid": "OrganizationTablesReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/Departments",
        "arn:aws:dynamodb:us-east-1:*:table/Roles"
      ]
    }
  ]
}
