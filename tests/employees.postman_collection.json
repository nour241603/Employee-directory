      "name": "0. Login and token security",
      "item": [
        {
          "name": "S1 Login as HR (Salma)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"salma.nabil@example.com\", \"password\": \"password123\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('token returned', function () { pm.expect(data.token).to.be.a('string'); });",
                  "pm.test('no passwordHash in response', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });",
                  "pm.collectionVariables.set('hrToken', data.token);"
                ]
              }
            }
          ]
        },
