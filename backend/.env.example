# Copy this file to .env and fill in the values. Never commit .env.
PORT=3000
NODE_ENV=development

# Website addresses allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4566

# DynamoDB tables
EMPLOYEES_TABLE=Employees
DEPARTMENTS_TABLE=Departments
ROLES_TABLE=Roles

# Floci endpoint for running on your PC (leave empty on Lambda)
AWS_PROFILE=floci
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566

# Login token signing key (Jana). Any long random text locally; on Lambda it comes from Secrets Manager.
AUTH_SECRET=change-me-locally
